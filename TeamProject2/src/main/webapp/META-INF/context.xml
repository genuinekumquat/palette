<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!--
      JNDI DataSource for the app. Looked up in com.itwillbs.dao.SQLConnection
      as java:comp/env/jdbc/teamproject2

      For local development, override the credentials below (or copy this file to
      context.local.xml, which is git-ignored) so real passwords are never committed.
      Run src/main/sql/schema.sql first to create the `teamproject2` database.
    -->
    <Resource name="jdbc/teamproject2"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/teamproject2?serverTimezone=Asia/Seoul&amp;characterEncoding=UTF-8"
              username="root"
              password="CHANGE_ME"
              maxTotal="20"
              maxIdle="10"
              maxWaitMillis="10000"/>
</Context>
